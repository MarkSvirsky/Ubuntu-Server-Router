pipeline {
    agent any

    stages {
        stage('Checkout Testing') {
            steps {
                // We now pull specifically from the 'testing' branch
                checkout scmGit(
                    branches: [[name: '*/testing']], 
                    userRemoteConfigs: [[
                        credentialsId: 'git-token', 
                        url: 'https://github.com/MarkSvirsky/Ubuntu-Server-Router.git'
                    ]]
                )
            }
        }

        stage('Validate DNS Config') {
            steps {
                sh "docker run --rm -i alpine sh -c 'apk add --no-cache dnsmasq && dnsmasq --test' < configs/dnsmasq/server-gateway.conf"
            }
        }

        stage('Validate IPTables Syntax') {
            steps {
                sh "docker run --rm --privileged -i alpine sh -c 'apk add --no-cache iptables && iptables-restore --test' < configs/routing/iptables.sh"
            }
        }

        stage('Promote to Main') {
            steps {
                echo '✅ Validation Passed! Merging Testing -> Main...'
                // Use the git-token to push the current state to the main branch
                withCredentials([usernamePassword(credentialsId: 'git-token', passwordVariable: 'GIT_TOKEN', usernameVariable: 'GIT_USER')]) {
                    sh """
                        # Configure git identity for the push
                        git config user.email "jenkins@junker-gateway"
                        git config user.name "Jenkins CI"
                        
                        # Push the current commit (HEAD) to the remote 'main' branch
                        git push https://${GIT_USER}:${GIT_TOKEN}@github.com/MarkSvirsky/Ubuntu-Server-Router.git HEAD:main
                    """
                }
            }
        }
    }
    
    post {
        success { 
            echo '🎉 SUCCESS: Testing branch validated and promoted to Main.' 
        }
        failure { 
            echo '❌ FAILURE: Testing branch has errors. Main branch remains safe.' 
        }
    }
}


